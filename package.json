{
  "name": "@shelamkoff/color-picker",
  "version": "1.0.0",
  "description": "Accessible framework-agnostic color picker with EyeDropper support, pure color utilities, and HEX, RGB, HSL, named-color, and OKLCH input",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./color-math": {
      "types": "./dist/colorMath.d.ts",
      "import": "./dist/colorMath.js"
    },
    "./styles.css": "./dist/colorPicker.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "demo": "node scripts/dev-server.mjs /demo.html",
    "test": "node --test test/*.test.js",
    "test:package": "node scripts/test-package.mjs",
    "prepublishOnly": "npm test",
    "prepack": "npm run build",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "npm test && npm run test:package && npm run test:browser"
  },
  "keywords": [
    "javascript",
    "color-picker",
    "color",
    "color-converter",
    "eyedropper",
    "hex",
    "rgb",
    "hsl",
    "hsv",
    "oklch",
    "accessibility",
    "vanilla-js",
    "framework-agnostic",
    "esm"
  ],
  "author": "Shelamkoff",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shelamkoff/color-picker.git"
  },
  "homepage": "https://shelamkoff.github.io/color-picker/",
  "bugs": {
    "url": "https://github.com/Shelamkoff/color-picker/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "playwright": "1.62.1",
    "typescript": "5.8.3"
  }
}
